# Copy to .env and change the secrets. Never commit .env.

# Profile: "local" (Docker stack below) or "aws" (see infra/).
LAKE_PROFILE=local
LAKE_BUCKET=ruc-lakehouse
AWS_REGION=us-east-1

# S3-compatible object storage (the keys are also its admin user)
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=lake-admin
S3_SECRET_KEY=change-me-storage

# Iceberg REST catalog (Lakekeeper)
CATALOG_URI=http://catalog:8181/catalog
CATALOG_WAREHOUSE=ruc
CATALOG_ENCRYPTION_KEY=change-me-catalog-encryption-key

# Postgres (catalog and orchestrator metadata only)
POSTGRES_USER=lake
POSTGRES_PASSWORD=change-me-postgres

# Jobs
# Folder of the daily collector (contains raw/snapshot_date=YYYY-MM-DD/).
SNAPSHOTS_HOST_DIR=./data/snapshots
SPARK_DRIVER_MEMORY=6g
